// Copy to Secrets.xcconfig (gitignored) and fill in from the same Supabase
// project the web app's .env.local points at — Project Settings → API.
//
// Host only, no scheme: xcconfig treats `//` as the start of a comment, so a
// full https:// URL would be cut off at the colon. Info.plist adds https://.
SUPABASE_HOST = your-project.supabase.co

// The anon key. It's public by design — the web app ships it to every
// browser — and Row Level Security is what actually protects the data.
// Never put the service-role key here.
SUPABASE_ANON_KEY = your-anon-key

// Where the web app is deployed, host only (e.g. tray.vercel.app). Settings
// links to its /privacy page, which App Store Connect also asks for. Leave
// empty and the link is hidden.
TRAY_WEB_HOST =
