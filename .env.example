# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Bypasses RLS — server-side only, never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret for the /api/cron/scrape endpoint. Any long random string:
#   openssl rand -hex 32
CRON_SECRET=

# Contact address advertised in the scraper's User-Agent, so UNC has a way to
# reach us if the scraper ever causes them trouble.
SCRAPER_CONTACT=you@unc.edu
